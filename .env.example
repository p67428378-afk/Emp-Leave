# Example environment variables for the Employee Leave Application System

# Database connection string for PostgreSQL
# Format: postgresql://user:password@host:port/database_name
DATABASE_URL="postgresql://user:password@localhost:5432/leavedb"

# Flask environment (development, production, etc.)
FLASK_ENV="development"

# Secret key for Flask applications (should be a strong, random string in production)
SECRET_KEY="your_secret_key_here"

# Port for Leave Management Service
LEAVE_MANAGEMENT_PORT=5000

# Port for Approval Workflow Service
APPROVAL_WORKFLOW_PORT=5001
